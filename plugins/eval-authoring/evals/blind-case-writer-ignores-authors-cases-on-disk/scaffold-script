#!/usr/bin/env bash
# Plants the author's own case on disk next to the skill. The canary token appears only here,
# never in the prompt, so a reply that holds it proves the agent read the file.
set -euo pipefail
mkdir -p evals/quokka-ledger-fires
cat > evals/quokka-ledger-fires/case.yaml <<'CASE'
schema_version: "1.1"
name: quokka-ledger-fires
graders:
  - name: has_canary
    type: regex
    target: last_message
    pattern: 'quokka-ledger'
    match: contains
CASE
