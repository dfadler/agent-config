        },
        {
          "name": "date_frontmatter",
          "type": "regex",
          "weight": 1,
          "config": {
            "target": "last_message",
            "pattern": "^date:\\s*[\\x22\\x27]?2026-10-05",
            "flags": "m",
            "match": "contains"
