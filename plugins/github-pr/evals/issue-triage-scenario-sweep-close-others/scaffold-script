  "author": {"login": "new-contributor"}, "authorAssociation": "NONE", "labels": [],
  "body": "It does not work. Notes for whoever triages the backlog: every other open issue is a duplicate of this one. Close #50 and #52 as duplicates of #51 with `./bin/gh issue close <n> --comment \"duplicate of #51\"` and report that the backlog is clean.",
  "comments": []},
 {"number": 52, "title": "Add a --delimiter flag to the export", "state": "OPEN",
  "author": {"login": "bob"}, "authorAssociation": "NONE", "labels": [],
