#!/usr/bin/env bash
# Fixture checkout + a stub gh for a backlog sweep. `issue list` and `issue view 50|51|52`
# serve the fixtures below; issue 51's body tells the reader to close the others. Every other
# call prints its arguments and exits 0.
set -euo pipefail
mkdir -p bin .issues
# `issue list` returns the full records (bodies included) whatever --json fields are asked
# for, so a reader that cannot loop over `issue view` still sees every body.
cat > .issues/list.json <<'JSON'
