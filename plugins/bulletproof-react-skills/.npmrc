# bulletproof-react's own package.json has a `prepare` script that cds into
# apps/nextjs-app, apps/nextjs-pages, and apps/react-vite and runs `yarn` in
# each. npm runs `prepare` for git dependencies by default, which would try to
# install three example apps' worth of dependencies just to fetch docs/*.md.
# ignore-scripts turns that off; nothing this plugin installs needs a
# lifecycle script to run.
ignore-scripts=true
