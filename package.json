{
  "name": "agent-config-scripts",
  "private": true,
  "type": "module",
  "description": "TypeScript tooling for agent-config scripts. Not published; pins dev dependencies and exposes the Node-based checks (`pnpm run <name>`); CI calls these, and `scripts/ci.sh` delegates to them.",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern scripts/ts \"plugins/*/scripts/ts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check-skills": "node scripts/ts/check-skill-contracts.ts .",
    "lint-plugin-evals": "node plugins/eval-authoring/scripts/ts/lint-repo.ts .",
    "lint-set-flags": "node scripts/ts/check-shell-set-flags.ts",
    "lint-claude-md": "node scripts/ts/check-claude-md-lines.ts claude/CLAUDE.md 350",
    "check-vitest-flags": "node scripts/ts/check-vitest-flags.ts",
    "check-vitest-v3-names": "node scripts/ts/check-vitest-v3-names.ts",
    "check-plugin-structure": "node scripts/ts/check-plugin-structure.ts .",
    "check-links": "node scripts/ts/check-markdown-links.ts --path .",
    "check": "bash scripts/ci.sh check",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-functional": "10.0.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
