{
  "name": "agent-config-scripts",
  "private": true,
  "type": "module",
  "description": "TypeScript tooling for agent-config scripts. Not published; pins dev dependencies and exposes the commands the Makefile calls.",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern scripts/ts \"plugins/*/scripts/ts/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "check-skills": "node scripts/ts/check-skill-contracts.ts .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-functional": "10.0.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
