{
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "scripts/ts/**/*.ts",
    "plugins/*/scripts/ts/**/*.ts",
    "!**/*.test.ts",
    "!**/test-support.ts",
    "!**/fixtures/**"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "reporters": ["clear-text", "progress"]
}
