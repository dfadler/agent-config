# Host-local Claude Code state. Excluding this in the repo's own .gitignore
# (rather than relying on a personal global gitignore) matters here more than
# in most repos: this repo is what a fresh machine bootstraps its Claude Code
# config from, so ~/.claude/settings.local.json can easily accumulate
# machine-specific paths before a global gitignore is even in place.
.claude/settings.local.json
